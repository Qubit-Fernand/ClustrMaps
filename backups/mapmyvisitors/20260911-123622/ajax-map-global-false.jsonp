backup("\n                    var add_markers = true;\n                    var blink_limit = 5;\n\n                    var blink_count = 0;\n                    var marker_keys = [];\n                    var marker_key_index = 0;\n                    var data = [];\n\n                    var blink_animation = setInterval(function(){\n                        blink_count++;\n                        \/\/console.log(blink_count);\n                        if(blink_count > blink_limit){\n                            _map.container.addClass('liveDotsReady');\n                            clearInterval(blink_animation);\n                            setTimeout(function(){\n                                _map.loadMore();\n                            }, 6000);\n\n                            return;\n                        }\n                        if(!add_markers && false){\n                            _map.mapObject.removeMarkers(marker_keys);\n                        }else{\n                            marker_keys = [];\n\n                                                            _map.mapObject.addMarker('1122946231',\n                    {\n                        latLng: [28, -68],\n                        \/*name: \"51 visits from unknown location\",*\/\n                       name: \"51 recent visits from unknown location\",\n                        style: {\n                          fill: _map.options.markerStyleFill,\/\/FFDD00\n                          stroke: _map.options.markerStyleStroke,\n                          \"fill-opacity\": 1,\n                          \"stroke-width\": .4,\n                          'r': (4*(blink_limit\/blink_count))\n                        }\n                    }\n                                    );\n                                marker_keys.push('1122946231');\n                                \n                                if(marker_keys.length === 0){\n                                    blink_count = blink_limit;\n    